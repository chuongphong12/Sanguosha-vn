{
  "name": "tqs-boardgame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run check && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "serve": "tsx --env-file=.env server/server.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.3.13",
    "@fontsource/noto-serif": "^5.3.0",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.3.2",
    "boardgame.io": "0.50.2",
    "motion": "^12.43.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
