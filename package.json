{
  "name": "tqs-boardgame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run check && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "serve": "tsx server/server.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.74",
    "@fontsource/noto-serif": "^5.3.0",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.2.2",
    "boardgame.io": "0.50.2",
    "motion": "^12.4.7",
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@assetpack/core": "^1.4.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "tsx": "^4.23.12",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
